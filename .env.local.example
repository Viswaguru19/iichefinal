NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend (email notifications)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL=IIChE AVVU Student Chapter <notifications@iicheavvu.in>
RESEND_REPLY_TO=admin@iicheavvu.in

# Web Push (free lock-screen notifications — generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@iicheavvu.in
PUSH_WEBHOOK_SECRET=your_random_webhook_secret

# Optional TURN for meetings when phones / campus Wi-Fi cannot connect peer-to-peer
# NEXT_PUBLIC_TURN_URLS=turn:your-turn-host:3478,turns:your-turn-host:443
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
