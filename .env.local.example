NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend (email notifications)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL=IIChE AVVU Student Chapter <notifications@iicheavvu.in>
RESEND_REPLY_TO=admin@iicheavvu.in

# Web Push (free lock-screen notifications — generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@iicheavvu.in
PUSH_WEBHOOK_SECRET=your_random_webhook_secret

# TURN relay for meetings. Without one, calls only connect when both people are
# on the same Wi-Fi — mobile networks put phones behind carrier NAT and the call
# ends up with no audio and no video on both sides.
#
# Easiest option: Cloudflare Realtime TURN (free tier). Create a TURN key at
# dash.cloudflare.com -> Realtime -> TURN, then set these two server-side vars.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
#
# Or point at any other TURN service / self-hosted coturn:
# TURN_URLS=turn:your-turn-host:3478,turns:your-turn-host:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# IIChE AI (optional). Without a key the assistant still answers portal how-to
# questions. With a key it uses a live model.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_API_KEY=
# OPENAI_API_KEY=
